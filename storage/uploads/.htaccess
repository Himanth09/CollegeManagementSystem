# Uploaded photos are served only through the authenticated API.
# Defence in depth: never execute scripts from this folder.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
<FilesMatch "\.(php|phtml|php\d|phar|pl|py|cgi|sh|html?|js)$">
    SetHandler none
    ForceType text/plain
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
